# Get these from https://app.tina.io once the project is connected to Tina Cloud.
# Not needed for local editing (npm run dev).
TINA_CLIENT_ID=
TINA_TOKEN=
TINA_BRANCH=main

# Contact form (EmailJS, https://dashboard.emailjs.com). Needed for the form to send e-mails.
# The recipient address is configured in the EmailJS template, not here.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
# Copy to the person who fills in the form (EmailJS Auto-Reply). true = template WITH Auto-Reply (2 e-mails),
# false = twin template WITHOUT Auto-Reply (1 e-mail, for testing). Default: true.
VITE_EMAILJS_SEND_COPY=true
VITE_EMAILJS_TEMPLATE_ID_NO_COPY=

# reCAPTCHA v2 checkbox ("No soy un robot"), https://www.google.com/recaptcha/admin
# Only the SITE key goes here; the SECRET key goes in EmailJS (template → Settings → reCAPTCHA).
VITE_RECAPTCHA_SITE_KEY=
